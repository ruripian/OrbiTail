# Python 런타임 산물
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 런타임 데이터 — 컨테이너에서는 named volume 으로 마운트된다
staticfiles/
mediafiles/
*.sqlite3

# celery beat 의 마지막 실행 시각 DB.
# 호스트에서 돌린 상태가 이미지에 박히면 beat 가 낡은 스케줄로 시작한다.
celerybeat-schedule
celerybeat-schedule.*

# 로컬 환경변수 — 런타임에 env_file 로 주입된다
.env
.env.*
