msgstr "이미 프로젝트 멤버입니다."

msgid "Only a project administrator can change roles."
msgstr "프로젝트 관리자만 역할을 변경할 수 있습니다."

msgid "Invalid role value."
msgstr "role 값이 올바르지 않습니다."

msgid "Only a project administrator can remove members."
msgstr "프로젝트 관리자만 멤버를 제거할 수 있습니다."

msgid "Only a planned sprint can be started."
msgstr "예정 상태의 스프린트만 시작할 수 있습니다."

#, python-format
msgid "A sprint is already active: \"%(name)s\". Complete it first."
msgstr "이미 진행 중인 스프린트가 있습니다: \"%(name)s\". 먼저 완료해 주세요."

msgid "Only an active sprint can be completed."
msgstr "진행 중인 스프린트만 완료할 수 있습니다."

msgid "The target sprint was not found."
msgstr "옮길 스프린트를 찾을 수 없습니다."

msgid "Only a workspace administrator can view this."
msgstr "워크스페이스 관리자만 볼 수 있습니다."

msgid "System"
msgstr "시스템"

msgid "Only a workspace member can be set as lead."
msgstr "워크스페이스 멤버만 리드로 지정할 수 있습니다."

#, python-format
msgid "%(name)s requested to join the '%(workspace)s' workspace."
msgstr "%(name)s님이 '%(workspace)s' 워크스페이스 가입을 신청했습니다."

#, python-format
msgid "Your request to join the '%(workspace)s' workspace was approved."
msgstr "'%(workspace)s' 워크스페이스 가입이 승인되었습니다."

#, python-format
msgid "Your request to join the '%(workspace)s' workspace was rejected."
msgstr "'%(workspace)s' 워크스페이스 가입 신청이 거절되었습니다."

msgid "Only a superadmin can create a workspace."
msgstr "워크스페이스 생성은 슈퍼어드민만 할 수 있습니다."

msgid "Workspace not found."
msgstr "워크스페이스를 찾을 수 없습니다."

msgid "Already a member."
msgstr "이미 멤버입니다."

msgid "Verify your email before requesting to join."
msgstr "이메일 인증 후 가입 신청이 가능합니다."

msgid "Request not found."
msgstr "신청을 찾을 수 없습니다."

msgid "Only an administrator can handle join requests."
msgstr "관리자만 가입 신청을 처리할 수 있습니다."

msgid "action must be approve or reject."
msgstr "action 은 approve|reject 중 하나여야 합니다."

msgid "Only the owner or a superadmin can delete a workspace."
msgstr "워크스페이스 삭제는 소유자 또는 슈퍼어드민만 할 수 있습니다."

msgid "Only administrators and above can edit workspace details."
msgstr "워크스페이스 정보 수정은 관리자 이상만 가능합니다."

msgid "You are not a member of this workspace."
msgstr "워크스페이스 멤버가 아닙니다."

msgid "Only administrators and above can manage members."
msgstr "관리자 이상만 멤버를 관리할 수 있습니다."

msgid "Member not found."
msgstr "멤버를 찾을 수 없습니다."

msgid "role is required."
msgstr "role이 필요합니다."

msgid "Only the current owner can change the owner."
msgstr "소유자 변경은 현재 소유자만 할 수 있습니다."

msgid "The last owner cannot be demoted. Make another member an owner first."
msgstr ""
"마지막 소유자는 강등할 수 없습니다. 먼저 다른 멤버를 소유자로 지정하세요."

msgid "Removing an owner requires owner rights."
msgstr "소유자를 제거하려면 소유자 권한이 필요합니다."

msgid "The last owner cannot be removed."
msgstr "마지막 소유자는 제거할 수 없습니다."

msgid "You cannot remove yourself."
msgstr "본인을 제거할 수 없습니다."

msgid "Only Admin and above can see the invitation list."
msgstr "Admin 이상만 초대 목록을 볼 수 있습니다."

msgid "You do not have permission to invite. Only Admin and above can invite."
msgstr "초대 권한이 없습니다. Admin 이상만 초대할 수 있습니다."

msgid "You cannot invite someone with a higher role than your own."
msgstr "자신보다 높은 역할로는 초대할 수 없습니다."

msgid "Already a workspace member."
msgstr "이미 워크스페이스 멤버입니다."

#, python-format
msgid "[OrbiTail] Invitation to the %(workspace)s workspace"
msgstr "[OrbiTail] %(workspace)s 워크스페이스 초대"

msgid "You do not have permission."
msgstr "권한이 없습니다."

msgid "Invitation not found."
msgstr "초대를 찾을 수 없습니다."

msgid "The invitation was revoked."
msgstr "초대가 취소되었습니다."

msgid "This invitation link is not valid."
msgstr "유효하지 않은 초대 링크입니다."

msgid "This invitation has expired or was already handled."
msgstr "만료되었거나 이미 처리된 초대입니다."

msgid "name, slug and owner_id are all required."
msgstr "name, slug, owner_id 가 모두 필요합니다."

msgid "That slug is already in use."
msgstr "이미 사용 중인 slug 입니다."

msgid "The user to make owner was not found."
msgstr "소유자로 지정할 사용자를 찾을 수 없습니다."

msgid "owner_id is required."
msgstr "owner_id 가 필요합니다."

#, python-format
msgid "This invitation was sent to %(email)s. Sign in with that email account."
msgstr ""
"이 초대는 %(email)s 앞으로 발송되었습니다. 해당 이메일 계정으로 로그인해주세"
"요."

msgid "Already a member of that workspace."
msgstr "이미 해당 워크스페이스의 멤버입니다."

msgid "Invitation accepted."
msgstr "초대를 수락했습니다."

msgid "Only a workspace member can create a team."
msgstr "워크스페이스 멤버만 팀을 만들 수 있습니다."

msgid "A team with that name already exists."
msgstr "같은 이름의 팀이 이미 있습니다."

msgid "Only a team administrator can edit this."
msgstr "팀 관리자만 수정할 수 있습니다."

msgid "Only a team administrator can delete this."
msgstr "팀 관리자만 삭제할 수 있습니다."

msgid "Only a team administrator can add members."
msgstr "팀 관리자만 멤버를 추가할 수 있습니다."

msgid "The member field is required."
msgstr "member 필드가 필요합니다."

msgid "Only workspace members can be added to the team."
msgstr "워크스페이스 멤버만 팀에 추가할 수 있습니다."

msgid "Already a team member."
msgstr "이미 팀 멤버입니다."

msgid "Only a team administrator can change roles."
msgstr "팀 관리자만 역할을 변경할 수 있습니다."

msgid "Only the member or a team administrator can change the title."
msgstr "본인 또는 팀 관리자만 직책을 변경할 수 있습니다."

#, python-format
msgid "A title can be at most %(max)s characters."
msgstr "직책은 %(max)s자까지 입력할 수 있습니다."

msgid "The role or title field is required."
msgstr "role 또는 title 필드가 필요합니다."

msgid "Only a team administrator can remove members."
msgstr "팀 관리자만 멤버를 제거할 수 있습니다."

msgid ""
"The last administrator cannot leave. Promote another member to administrator "
"or delete the team."
msgstr ""
"마지막 관리자는 탈퇴할 수 없습니다. 다른 멤버를 관리자로 승격하거나 팀을 삭제"
"해주세요."
