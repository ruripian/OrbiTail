msgid "Too many failed sign-in attempts. Please try again later."
msgstr "로그인 실패가 너무 많습니다. 잠시 후 다시 시도해 주세요."

msgid "New feature"
msgstr "신규 기능"

msgid "Improvement"
msgstr "개선"

msgid "Bug fix"
msgstr "버그 수정"

msgid "Notice"
msgstr "공지"

#, python-format
msgid "The profile photo must be %(mb)sMB or smaller."
msgstr "프로필 사진은 %(mb)sMB 이하만 가능합니다."

msgid "That email address is already in use."
msgstr "이미 사용 중인 이메일입니다."

msgid "The password must contain letters, digits and symbols."
msgstr "비밀번호는 영문, 숫자, 특수문자를 모두 포함해야 합니다."

msgid ""
"You are registered as the first administrator. You can sign in right away."
msgstr "첫 관리자 계정으로 등록되었습니다. 바로 로그인할 수 있습니다."

msgid "Invitation accepted. You can sign in right away."
msgstr "초대 수락 완료. 바로 로그인할 수 있습니다."

msgid "[OrbiTail] Verify your email"
msgstr "[OrbiTail] 이메일 인증 안내"

#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Welcome to OrbiTail.\n"
"Click the link below to verify your email.\n"
"\n"
"%(url)s\n"
"\n"
"Once verified, you will wait for a workspace administrator to approve your "
"sign-up.\n"
"After approval you can enter the workspace.\n"
"This link expires in 24 hours."
msgstr ""
"안녕하세요, %(name)s님.\n"
"\n"
"OrbiTail 에 가입하신 것을 환영합니다.\n"
"아래 링크를 클릭하여 이메일 인증을 완료해주세요.\n"
"\n"
"%(url)s\n"
"\n"
"인증을 완료하면 워크스페이스 관리자의 가입 승인을 기다리게 됩니다.\n"
"승인이 완료되면 워크스페이스에 입장할 수 있습니다.\n"
"이 링크는 24시간 후 만료됩니다."

msgid "Sign-up complete. Check your email to finish verification."
msgstr "가입 완료. 이메일을 확인하여 인증을 완료해주세요."

msgid "Sign-up complete. You can sign in right away."
msgstr "가입 완료. 바로 로그인할 수 있습니다."

msgid "The file field is required."
msgstr "file 필드가 필요합니다."

#, python-format
msgid "Images must be %(mb)sMB or smaller."
msgstr "이미지는 %(mb)sMB 이하만 업로드할 수 있습니다."

msgid "That image format is not allowed."
msgstr "허용되지 않는 이미지 형식입니다."

msgid "Only image files can be uploaded."
msgstr "이미지 파일만 업로드할 수 있습니다."

msgid "Enter your password."
msgstr "비밀번호를 입력해주세요."

msgid "The password is incorrect."
msgstr "비밀번호가 올바르지 않습니다."

msgid "Your account has been deleted."
msgstr "계정이 삭제되었습니다."

msgid "Your current password is incorrect."
msgstr "현재 비밀번호가 올바르지 않습니다."

msgid "Your password has been changed."
msgstr "비밀번호가 변경되었습니다."

msgid "[OrbiTail] Confirm your email change"
msgstr "[OrbiTail] 이메일 변경 인증"

#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Click the link below to finish changing your email.\n"
"\n"
"%(url)s\n"
"\n"
"This link expires in 24 hours.\n"
"If you did not request this, you can ignore this email."
msgstr ""
"안녕하세요, %(name)s님.\n"
"\n"
"아래 링크를 클릭하여 이메일 변경을 완료하세요.\n"
"\n"
"%(url)s\n"
"\n"
"이 링크는 24시간 후 만료됩니다.\n"
"본인이 요청하지 않은 경우 이 메일을 무시하세요."

msgid "A verification email has been sent."
msgstr "인증 메일을 발송했습니다."

msgid "Invalid token."
msgstr "유효하지 않은 토큰입니다."

msgid "This link has expired. Request the email change again."
msgstr "만료된 토큰입니다. 이메일 변경을 다시 요청해주세요."

msgid "Your email has been changed."
msgstr "이메일이 변경되었습니다."

msgid "This link has expired."
msgstr "만료된 토큰입니다."

msgid ""
"Your email has been verified. Please wait for a workspace administrator to "
"approve you."
msgstr ""
"이메일 인증이 완료되었습니다. 워크스페이스 관리자 승인을 기다려 주세요."

msgid "Your email has been verified. Sign in and request to join a workspace."
msgstr ""
"이메일 인증이 완료되었습니다. 로그인 후 워크스페이스에 가입 신청해 주세요."

msgid ""
"If that email is registered, password reset instructions will be sent to it."
msgstr "해당 이메일로 비밀번호 재설정 안내가 발송됩니다."

msgid "[OrbiTail] Reset your password"
msgstr "[OrbiTail] 비밀번호 재설정"

#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"Click the link below to reset your password.\n"
"\n"
"%(url)s\n"
"\n"
"This link expires in 1 hour."
msgstr ""
"안녕하세요, %(name)s님.\n"
"\n"
"아래 링크를 클릭하여 비밀번호를 재설정하세요.\n"
"\n"
"%(url)s\n"
"\n"
"이 링크는 1시간 후 만료됩니다."

msgid "Your password was changed successfully."
msgstr "비밀번호가 성공적으로 변경되었습니다."

msgid "User not found."
msgstr "사용자를 찾을 수 없습니다."

msgid "This user is already approved."
msgstr "이미 승인된 사용자입니다."

msgid "[OrbiTail] Your account has been approved"
msgstr "[OrbiTail] 계정 승인 완료 안내"

#, python-format
msgid ""
"Hello %(name)s,\n"
"\n"
"An administrator has approved your OrbiTail account.\n"
"You can now sign in.\n"
"\n"
"Sign in: %(url)s"
msgstr ""
"안녕하세요, %(name)s님.\n"
"\n"
"관리자가 OrbiTail 계정을 승인했습니다.\n"
"이제 로그인하여 이용할 수 있습니다.\n"
"\n"
"로그인 주소: %(url)s"

msgid "The user has been approved."
msgstr "사용자가 승인되었습니다."

msgid "The is_superuser value is required."
msgstr "is_superuser 값이 필요합니다."

msgid ""
"You cannot remove your own superuser rights. Another superuser has to do it."
msgstr ""
"본인의 슈퍼유저 권한은 해제할 수 없습니다. 다른 슈퍼유저가 대신 진행해야 합니"
"다."

msgid "The last superuser cannot be demoted."
msgstr "마지막 슈퍼유저는 강등할 수 없습니다."

msgid "You cannot suspend yourself."
msgstr "본인을 정지할 수 없습니다."

msgid "A superuser cannot be suspended. Remove their superuser rights first."
msgstr "슈퍼유저는 정지할 수 없습니다. 먼저 슈퍼유저 권한을 해제하세요."

msgid "You cannot delete yourself."
msgstr "본인은 삭제할 수 없습니다."

msgid "A superuser cannot be deleted. Remove their superuser rights first."
msgstr "슈퍼유저는 삭제할 수 없습니다. 먼저 슈퍼유저 권한을 해제하세요."

#, python-format
msgid "Invalid date format: %(value)s"
msgstr "날짜 형식이 올바르지 않습니다: %(value)s"

#, python-format
msgid "A number is required: %(value)s"
msgstr "숫자가 필요합니다: %(value)s"

#, python-format
msgid "true or false is required: %(value)s"
msgstr "true/false 가 필요합니다: %(value)s"

#, python-format
msgid "Cannot sort by this field: %(field)s (allowed: %(allowed)s)"
msgstr "정렬할 수 없는 필드입니다: %(field)s (가능: %(allowed)s)"

msgid "none"
msgstr "없음"

msgid "This token does not have write permission."
msgstr "이 토큰에는 쓰기 권한이 없습니다."

msgid "Enter a name."
msgstr "이름을 입력하세요."

#, python-format
msgid "Unknown event: %(events)s"
msgstr "알 수 없는 이벤트: %(events)s"

msgid "The OrbiTail webhook is connected."
msgstr "OrbiTail 웹훅이 연결되었습니다."

msgid "This webhook is turned off."
msgstr "웹훅이 꺼져 있습니다."

#, python-format
msgid "Connection failed: %(error)s"
msgstr "연결 실패: %(error)s"

#, python-format
msgid "Turned off automatically after %(count)s failed deliveries in a row."
msgstr "연속 %(count)s건 전달에 실패해 자동으로 껐습니다."

msgid ""
"Send a token created under Workspace settings › API tokens as "
"`Authorization: Bearer orbt_…`.\n"
"\n"
"- The workspace comes from the token — do not put it in the URL.\n"
"- A token acts with the permissions of the person who created it. Whatever "
"they cannot see, the token cannot see either.\n"
"- A read token can only read; a write token can also create, update and "
"delete.\n"
"- Bodies (issue descriptions, comments, documents) are exchanged as "
"Markdown.\n"
"- Lists are paginated with `?page=` and `&page_size=` (up to 100)."
msgstr ""
"워크스페이스 설정 › API 토큰에서 만든 토큰을 `Authorization: Bearer orbt_…` "
"로 보냅니다.\n"
"\n"
"- 워크스페이스는 토큰에서 정해집니다 — 주소에 넣지 않습니다.\n"
"- 토큰은 만든 사람의 권한으로 동작합니다. 그 사람이 볼 수 없는 것은 토큰도 "
"볼 수 없습니다.\n"
"- read 토큰은 조회만, write 토큰은 만들기·고치기·지우기까지 할 수 있습니다.\n"
"- 본문(이슈 설명·댓글·문서)은 마크다운으로 주고받습니다.\n"
"- 목록은 `?page=` `&page_size=`(최대 100)로 나눠 받습니다."

msgid "Identifier placed before issue numbers, e.g. OUR"
msgstr "이슈 번호 앞에 붙는 식별자. 예: OUR"

msgid "Human-readable number, e.g. OUR-12"
msgstr "사람이 읽는 번호. 예: OUR-12"

msgid "Markdown"
msgstr "마크다운"

msgid "Required on create. Cannot be changed"
msgstr "생성 시 필수. 수정할 수 없다"

msgid "Defaults to the project's default state"
msgstr "생략하면 프로젝트의 기본 상태"

msgid "List of user ids — replaces the whole set"
msgstr "사용자 id 목록 — 통째로 교체"

msgid "List of label ids — replaces the whole set"
msgstr "라벨 id 목록 — 통째로 교체"

msgid "Enter a title."
msgstr "제목을 입력하세요."

msgid "The due date cannot be earlier than the start date."
msgstr "마감일이 시작일보다 앞설 수 없습니다."

msgid "Id of the comment to reply to"
msgstr "답글을 달 댓글 id"

msgid "Enter some content."
msgstr "내용을 입력하세요."

msgid "Body as Markdown (no front matter)"
msgstr "본문 마크다운 (머리말 없음)"

msgid "Id of a document or folder in the same space"
msgstr "같은 스페이스의 문서·폴더 id"

msgid "Body as Markdown"
msgstr "본문 마크다운"

msgid "Where to move it. null means the top level"
msgstr "옮길 곳. null 이면 최상위"

msgid "Replaces the whole set"
msgstr "통째로 교체"

msgid "Check the token — who it acts as, which workspace, and what permission"
msgstr "토큰 확인 — 누구로, 어느 워크스페이스에, 어떤 권한으로 붙었는지"

msgid "Project not found."
msgstr "프로젝트를 찾을 수 없습니다."

msgid "List projects"
msgstr "프로젝트 목록"

msgid "Include archived projects"
msgstr "보관된 프로젝트도 포함"

msgid "Project"
msgstr "프로젝트"

msgid "Project states"
msgstr "프로젝트의 상태 목록"

msgid "Project labels"
msgstr "프로젝트의 라벨 목록"

msgid "Project sprints"
msgstr "프로젝트의 스프린트 목록"

msgid "Project categories"
msgstr "프로젝트의 카테고리 목록"

msgid "Project members"
msgstr "프로젝트 멤버"

msgid "Issue not found."
msgstr "이슈를 찾을 수 없습니다."

msgid "Only a project member can do this."
msgstr "프로젝트 멤버만 할 수 있습니다."

#, python-format
msgid "You do not have permission for this action. (%(perm)s)"
msgstr "이 작업에 대한 권한이 없습니다. (%(perm)s)"

msgid "That state does not belong to this project."
msgstr "이 프로젝트의 상태가 아닙니다."

msgid "That sprint does not belong to this project."
msgstr "이 프로젝트의 스프린트가 아닙니다."

msgid "That category does not belong to this project."
msgstr "이 프로젝트의 카테고리가 아닙니다."

msgid "That issue does not belong to this project."
msgstr "이 프로젝트의 이슈가 아닙니다."

msgid "It cannot be moved under itself or one of its own sub-issues."
msgstr "자기 자신이나 하위 이슈 밑으로 옮길 수 없습니다."

msgid "Some labels do not belong to this project."
msgstr "이 프로젝트의 라벨이 아닌 것이 있습니다."

msgid "Some users are not members of this workspace."
msgstr "이 워크스페이스의 멤버가 아닌 사용자가 있습니다."

msgid "List issues"
msgstr "이슈 목록"

msgid "User id, or me"
msgstr "사용자 id 또는 me"

msgid "Issue id, or none (top-level issues only)"
msgstr "이슈 id, 또는 none(최상위 이슈만)"

msgid "Only issues changed after this time — for syncing"
msgstr "이 시각 이후 바뀐 이슈만 — 동기화용"

msgid "Text contained in the title"
msgstr "제목에 포함된 글자"

msgid ""
"-updated_at (default) | updated_at | created_at | -created_at | sequence | "
"-sequence"
msgstr ""
"-updated_at(기본) | updated_at | created_at | -created_at | sequence | "
"-sequence"

msgid "Up to 100"
msgstr "최대 100"

msgid "Not a valid id."
msgstr "id 형식이 아닙니다."

msgid "Must be a user id or 'me'."
msgstr "사용자 id 또는 me 여야 합니다."

msgid "Must be an issue id or 'none'."
msgstr "이슈 id 또는 none 이어야 합니다."

msgid "Must be an ISO 8601 timestamp, e.g. 2026-09-15T09:00:00+09:00"
msgstr "ISO 8601 시각이어야 합니다. 예: 2026-09-15T09:00:00+09:00"

#, python-format
msgid "Must be one of: %(choices)s"
msgstr "다음 중 하나여야 합니다: %(choices)s"

msgid "Create an issue (write)"
msgstr "이슈 만들기 (write)"

msgid "This field is required."
msgstr "필수입니다."

msgid "Issue — by id or number (OUR-12)"
msgstr "이슈 — id 또는 번호(OUR-12)"

msgid "Update an issue — only the fields sent change (write)"
msgstr "이슈 고치기 — 보낸 필드만 바뀐다 (write)"

msgid "An issue cannot be moved to a different project."
msgstr "이슈를 다른 프로젝트로 옮길 수 없습니다."

msgid "Delete an issue — moves it to the trash with its sub-issues (write)"
msgstr "이슈 지우기 — 휴지통으로, 하위 이슈 포함 (write)"

msgid "List issue comments"
msgstr "이슈 댓글 목록"

msgid "Add a comment (write)"
msgstr "댓글 달기 (write)"

msgid "That comment does not belong to this issue."
msgstr "이 이슈의 댓글이 아닙니다."

msgid "Space not found."
msgstr "스페이스가 없습니다."

msgid "You do not have edit permission for this space."
msgstr "이 스페이스의 편집 권한이 없습니다."

msgid "That document does not belong to this space."
msgstr "이 스페이스의 문서가 아닙니다."

msgid "It cannot be moved under itself or one of its own sub-documents."
msgstr "자기 자신이나 하위 문서 밑으로 옮길 수 없습니다."

msgid "Document not found."
msgstr "문서를 찾을 수 없습니다."

msgid "List document spaces"
msgstr "문서 스페이스 목록"

msgid "List documents in a space — folder structure via parent"
msgstr "스페이스의 문서 목록 — 폴더 구조는 parent 로"

msgid "Must be an ISO 8601 timestamp."
msgstr "ISO 8601 시각이어야 합니다."

msgid "Create a document (write)"
msgstr "문서 만들기 (write)"

msgid "A folder cannot have body content."
msgstr "폴더에는 본문을 넣을 수 없습니다."

msgid "Document — body as Markdown"
msgstr "문서 — 본문은 마크다운"

msgid "Update title, location, properties (write) — body via content/"
msgstr "제목·위치·프로퍼티 고치기 (write) — 본문은 content/"

msgid ""
"Delete a document — moves it to the trash with its sub-documents (write)"
msgstr "문서 지우기 — 휴지통으로, 하위 문서 포함 (write)"

msgid "A folder has no body content."
msgstr "폴더에는 본문이 없습니다."

msgid ""
"Could not reach the real-time collaboration server, so the body was not "
"changed. Try again shortly."
msgstr ""
"실시간 협업 서버에 닿지 못해 본문을 고치지 못했습니다. 잠시 뒤 다시 시도하세"
"요."

msgid "Replace the whole body (write)"
msgstr "본문 통째로 바꾸기 (write)"

msgid ""
"Safe even while someone is editing. The change is applied as an edit to the "
"live document, shows up immediately on open screens, and unchanged "
"paragraphs are kept."
msgstr ""
"편집 중인 사람이 있어도 안전합니다. 살아 있는 문서에 편집으로 반영되어 열어 "
"둔 화면에도 바로 나타나고, 바뀌지 않은 문단은 그대로 남습니다."

msgid "Append to the body (write) — for accumulating logs or meeting notes"
msgstr "본문 끝에 덧붙이기 (write) — 로그·회의록 누적용"

msgid "Only an administrator can see all tokens."
msgstr "관리자만 전체 토큰을 볼 수 있습니다."

msgid "API tokens cannot be created in the demo."
msgstr "데모에서는 API 토큰을 만들 수 없습니다."

msgid "Guests cannot create API tokens."
msgstr "게스트는 API 토큰을 만들 수 없습니다."

#, python-format
msgid ""
"You can have at most %(max)s active tokens. Revoke the ones you no longer "
"use."
msgstr "살아 있는 토큰은 %(max)s개까지입니다. 안 쓰는 토큰을 폐기하세요."

msgid "Only a workspace administrator can manage webhooks."
msgstr "워크스페이스 관리자만 웹훅을 관리할 수 있습니다."

msgid "Webhooks cannot be created in the demo."
msgstr "데모에서는 웹훅을 만들 수 없습니다."

#, python-format
msgid "A workspace can have at most %(max)s webhooks."
msgstr "웹훅은 워크스페이스당 %(max)s개까지입니다."

msgid "This webhook is off. Turn it on first."
