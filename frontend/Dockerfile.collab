# 실시간 협업 서버 (Hocuspocus) — 운영 이미지.
#
# 프론트와 같은 build context 를 쓰는 게 핵심이다. 문서 스키마(src/components/documents/doc-schema.ts)와
# TipTap 버전을 브라우저와 한 벌로 공유해야, 서버가 만드는 HTML 이 브라우저가 만드는 것과 어긋나지 않는다.
FROM node:20-alpine

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci

# 서버 실행에 필요한 것만 — dist 빌드는 하지 않는다(브라우저 번들은 frontend 이미지가 만든다)
COPY tsconfig.json ./
COPY collab ./collab
COPY src ./src

EXPOSE 1234

CMD ["npm", "run", "collab"]
