# ═══════════════════════════════════════════════════
# OrbiTail — 환경 변수 설정
# ═══════════════════════════════════════════════════

# ── Django ──
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ── 로그인 잠금 (django-axes) ──
# 앞단 프록시 개수. 0 이면 axes 가 REMOTE_ADDR 을 클라이언트 IP 로 본다.
# 리버스 프록시 뒤에서는 그게 프록시의 IP 라 모든 사용자가 IP 하나를 공유하게 되고,
# 한 사람의 로그인 실패 5회로 전체가 잠긴다. 앞단 프록시 수만큼 지정할 것.
#   nginx 만                → 1
#   Caddy → nginx 처럼 2단  → 2
AXES_IPWARE_PROXY_COUNT=0

# ── HTTPS (Let's Encrypt) ──
# 도메인을 설정하면 HTTPS 자동 활성화, 비워두면 HTTP 모드
DOMAIN=
# 인증서 만료 알림용 이메일 (선택)
CERTBOT_EMAIL=

# ── Docker nginx 포트 바인딩 ──
# 단독 서버(직접 80/443 노출):
#   HOST_BIND_ADDR=0.0.0.0  HOST_HTTP_PORT=80  HOST_HTTPS_PORT=443
# 호스트 nginx 뒤에 둘 때(reverse proxy, 다른 서비스와 공존):
#   HOST_BIND_ADDR=127.0.0.1  HOST_HTTP_PORT=8088  HOST_HTTPS_PORT=8443
HOST_BIND_ADDR=0.0.0.0
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# ── Database ──
POSTGRES_DB=orbitail
POSTGRES_USER=orbitail
POSTGRES_PASSWORD=orbitail
DB_HOST=db
DB_PORT=5432

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Frontend ──
# VITE_API_URL은 더 이상 사용 안 함 — axios가 상대경로 /api로 호출
# (개발: vite proxy, 프로덕션: nginx proxy)
FRONTEND_URL=http://localhost:5173

# ── 파일 업로드 한도 ──
# 두 값을 반드시 같이 바꿀 것. 어긋나면 사용자가 고를 수 있는 파일을
# 서버가 413 으로 거부하거나(프론트만 큼), UI 가 먼저 막는다(서버만 큼).
#   MAX_UPLOAD_SIZE_MB      → nginx client_max_body_size + Django 검증 (실제 거부 주체)
#   VITE_MAX_UPLOAD_SIZE_MB → 프론트 사전 검증
# 주의: VITE_ 쪽은 런타임 값이 아니라 빌드 시점에 번들에 박힌다.
#       프로덕션에서 값을 바꾸면 프론트 이미지를 다시 빌드해야 반영된다.
MAX_UPLOAD_SIZE_MB=10
VITE_MAX_UPLOAD_SIZE_MB=10

# ── Sponsor Button ──
# true로 설정하면 우측 하단 후원 버튼 표시, false면 숨김
VITE_SHOW_SPONSOR=true

# ── Email (SMTP) ──
# 개발 환경에서는 콘솔 백엔드 사용 (터미널에 이메일 출력)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# 프로덕션 예시 (SendGrid):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False        # 465 포트처럼 SSL 직결이면 True (TLS 와 동시에 켜면 안 됨)
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.xxxxx
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# 프로덕션 예시 (AWS SES):
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=AKIA...
# EMAIL_HOST_PASSWORD=...
# DEFAULT_FROM_EMAIL=noreply@your-domain.com

# ── 배포 이미지 태그 ──
# docker-compose.prod.yml 이 참조하는 이미지 태그.
# 지정하지 않으면 local 이라 `up -d --build` 가 그 자리에서 빌드해 그대로 쓴다.
# 운영에서 되돌릴 수 있게 하려면 배포한 커밋 SHA 를 넣어 고정한다.
#   TAG=8f3a91c
# TAG=local

# ── 데모 모드 ──
# 공개 데모 배포에서만 True. 켜지면
#   - 방문자가 로그인 없이 격리된 샌드박스(전용 워크스페이스)를 발급받고
#   - 관리자 콘솔·파일 업로드·메일 발송이 차단되며
#   - 샌드박스가 DEMO_SANDBOX_TTL_HOURS 뒤 자동 삭제된다
# 실사용 배포에서는 반드시 False 로 둘 것.
DEMO_MODE=False
# DEMO_SANDBOX_TTL_HOURS=24
# DEMO_MAX_SANDBOXES_PER_CLIENT=3
# DEMO_RATE_WINDOW_MINUTES=60
# DEMO_MAX_ISSUES_PER_SANDBOX=500
# DEMO_MAX_DOCUMENTS_PER_SANDBOX=200
# DEMO_MAX_WORKSPACES_PER_SANDBOX=5

# ── 개발 HMR (리버스 프록시 뒤에서 개발할 때만) ──
# HMR 은 브라우저가 dev 서버로 WebSocket 을 되잡아야 동작한다. 기본값은
# "페이지 호스트 + 5173" 인데, 프록시(tailscale serve, ngrok, nginx 등) 뒤에서
# 열면 그 포트가 밖으로 열려 있지 않아 실패하고 매번 새로고침해야 한다.
# 프록시가 듣는 포트를 지정하면 그쪽으로 되잡는다.
# DEV_HMR_CLIENT_PORT=8443
# DEV_HMR_PROTOCOL=wss     # 평문 프록시면 ws
